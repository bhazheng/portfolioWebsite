---
import { UI, CV_URL, type Locale } from '../i18n'

interface Props { lang: Locale }
const { lang } = Astro.props
const ui = UI[lang]
const EMAIL = 'akbarlucky@protonmail.com'
const newTab = ui.hero.newTab

// Channel tiles. Brand names are proper nouns; hints are localized or are the account handle.
const channels = [
  { icon: 'i-mdi:whatsapp brand-whatsapp', label: 'WhatsApp', hint: ui.contact.whatsappHint, href: 'https://wa.me/6285172455808' },
  { icon: 'i-mdi:linkedin brand-linkedin', label: 'LinkedIn', hint: 'akbarlucky', href: 'https://www.linkedin.com/in/akbarlucky/' },
  { icon: 'i-mdi:github', label: 'GitHub', hint: 'bhazheng', href: 'https://github.com/bhazheng' },
  { icon: 'i-material-symbols:description text-tertiary', label: ui.hero.cvCta, hint: ui.contact.cvHint, href: CV_URL }
]
---
<section id="contact" class="rei-section page-width">
  <div class="contact-section-inner contact-v2" data-reveal>
    <div class="contact-shape">
      <svg class="contact-shape-bg" viewBox="0 0 100 100" fill="none" aria-hidden="true">
        <path d="M 98.8 50 L 97.8 53.8 L 94.9 57.1 L 91.3 59.9 L 88.1 62.4 L 86.2 65 L 85.7 68.2 L 86.2 72.2 L 86.8 76.7 L 86.4 81.1 L 84.5 84.5 L 81.1 86.4 L 76.7 86.8 L 72.2 86.2 L 68.2 85.7 L 65 86.2 L 62.4 88.1 L 59.9 91.3 L 57.1 94.9 L 53.8 97.8 L 50 98.8 L 46.2 97.8 L 42.9 94.9 L 40.1 91.3 L 37.6 88.1 L 35 86.2 L 31.8 85.7 L 27.8 86.2 L 23.3 86.8 L 18.9 86.4 L 15.5 84.5 L 13.6 81.1 L 13.2 76.7 L 13.8 72.2 L 14.3 68.2 L 13.8 65 L 11.9 62.4 L 8.7 59.9 L 5.1 57.1 L 2.2 53.8 L 1.2 50 L 2.2 46.2 L 5.1 42.9 L 8.7 40.1 L 11.9 37.6 L 13.8 35 L 14.3 31.8 L 13.8 27.8 L 13.2 23.3 L 13.6 18.9 L 15.5 15.5 L 18.9 13.6 L 23.3 13.2 L 27.8 13.8 L 31.8 14.3 L 35 13.8 L 37.6 11.9 L 40.1 8.7 L 42.9 5.1 L 46.2 2.2 L 50 1.2 L 53.8 2.2 L 57.1 5.1 L 59.9 8.7 L 62.4 11.9 L 65 13.8 L 68.2 14.3 L 72.2 13.8 L 76.7 13.2 L 81.1 13.6 L 84.5 15.5 L 86.4 18.9 L 86.8 23.3 L 86.2 27.8 L 85.7 31.8 L 86.2 35 L 88.1 37.6 L 91.3 40.1 L 94.9 42.9 L 97.8 46.2 Z" fill="currentColor" />
      </svg>
      <span class="i-material-symbols:forum icon" style="font-size:40px;width:40px;height:40px" aria-hidden="true"></span>
    </div>

    <div class="contact-copy">
      <span class="eyebrow font-mono" aria-hidden="true"><span>//</span> 05 · {ui.nav.contact}</span>
      <h2>{ui.contact.heading}</h2>
      <p class="contact-sub">{ui.contact.subtitle}</p>
      <div class="email-row">
        <a href={`mailto:${EMAIL}`} class="email-link font-mono">
          <span class="i-material-symbols:mail icon" style="font-size:24px;width:24px;height:24px" aria-hidden="true"></span>
          {EMAIL}
        </a>
        <button
          type="button"
          class="copy-btn font-mono"
          hidden
          data-copy={EMAIL}
          data-label-copied={ui.contact.copied}
        >
          <span class="i-material-symbols:content-copy icon" style="font-size:16px;width:16px;height:16px" aria-hidden="true"></span>
          <span class="copy-label">{ui.contact.copy}</span>
        </button>
      </div>
    </div>

    <ul class="contact-channels">
      {channels.map((c, index) => (
        <li data-reveal data-reveal-delay={index * 80}>
          <a
            href={c.href}
            target="_blank"
            rel="noopener noreferrer"
            class="channel"
            aria-label={`${c.label} (${newTab})`}
          >
            <span class="channel-icon">
              <span class={`${c.icon} icon`} style="font-size:22px;width:22px;height:22px" aria-hidden="true"></span>
            </span>
            <span class="channel-text">
              <strong>{c.label}</strong>
              <span class="font-mono">{c.hint}</span>
            </span>
            <span class="i-material-symbols:arrow-outward icon channel-arrow" style="font-size:18px;width:18px;height:18px" aria-hidden="true"></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
