---
import { PROJECTS } from '../data/projects'
import { UI, type Locale } from '../i18n'

interface Props { lang: Locale }
const { lang } = Astro.props
const ui = UI[lang]
---
<section id="projects" class="rei-section page-width">
  <div class="section-heading" data-reveal>
    <span class="eyebrow font-mono" aria-hidden="true"><span>//</span> 03 · {ui.nav.projects}</span>
    <h2>{ui.projects.heading}<span class="heading-dot">.</span></h2>
    <p>{ui.projects.subtitle}</p>
  </div>

  <div class="project-grid">
    {PROJECTS[lang].map((project, index) => (
      <button
        type="button"
        class:list={['project-card', project.artClass]}
        data-project-open={project.id}
        aria-haspopup="dialog"
        aria-controls={`project-dialog-${project.id}`}
        data-reveal
        data-reveal-delay={index * 120}
      >
        <div class="project-art">
          <span class="project-category font-mono">{project.category}</span>
          <span class:list={[project.glyph, 'project-glyph', 'icon']} style="font-size:96px;width:96px;height:96px" aria-hidden="true"></span>
          <span class="project-number font-mono">{String(index + 1).padStart(2, '0')}</span>
          <span class="project-arrow">
            <span class="i-material-symbols:arrow-outward icon" style="font-size:20px;width:20px;height:20px" aria-hidden="true"></span>
          </span>
        </div>
        <div class="project-content">
          <svg class="card-accessory acc-0" viewBox="0 0 100 100" fill="none" aria-hidden="true">
            <path class="accessory-morph" d="M 96.4 50.0 L 95.7 54.5 L 93.7 58.7 L 90.6 62.3 L 87.0 65.3 L 83.1 67.7 L 79.5 69.7 L 76.3 71.6 L 73.8 73.8 L 71.6 76.3 L 69.7 79.5 L 67.7 83.1 L 65.3 87.0 L 62.3 90.6 L 58.7 93.7 L 54.5 95.7 L 50.0 96.4 L 45.5 95.7 L 41.3 93.7 L 37.7 90.6 L 34.7 87.0 L 32.3 83.1 L 30.3 79.5 L 28.4 76.3 L 26.2 73.8 L 23.7 71.6 L 20.5 69.7 L 16.9 67.7 L 13.0 65.3 L 9.4 62.3 L 6.3 58.7 L 4.3 54.5 L 3.6 50.0 L 4.3 45.5 L 6.3 41.3 L 9.4 37.7 L 13.0 34.7 L 16.9 32.3 L 20.5 30.3 L 23.7 28.4 L 26.2 26.2 L 28.4 23.7 L 30.3 20.5 L 32.3 16.9 L 34.7 13.0 L 37.7 9.4 L 41.3 6.3 L 45.5 4.3 L 50.0 3.6 L 54.5 4.3 L 58.7 6.3 L 62.3 9.4 L 65.3 13.0 L 67.7 16.9 L 69.7 20.5 L 71.6 23.7 L 73.8 26.2 L 76.3 28.4 L 79.5 30.3 L 83.1 32.3 L 87.0 34.7 L 90.6 37.7 L 93.7 41.3 L 95.7 45.5 Z" fill="currentColor" opacity="0.18" />
            <circle cx="50" cy="50" r="14" fill="currentColor" opacity="0.22" />
          </svg>
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <div class="project-highlights">
            {project.highlights.map((h) => (
              <div>
                <strong class="font-mono">{h.value}</strong>
                <span>{h.label}</span>
              </div>
            ))}
          </div>
          <div class="project-tags">
            {project.tech.map((t) => <span class="font-mono">{t}</span>)}
          </div>
        </div>
      </button>
    ))}
  </div>

  {PROJECTS[lang].map((project) => (
    <dialog
      id={`project-dialog-${project.id}`}
      class="project-dialog"
      aria-labelledby={`project-dialog-title-${project.id}`}
    >
      <div class:list={['project-dialog-header', project.artClass]}>
        <div class="project-dialog-title-wrap">
          <span class="project-dialog-category font-mono">{project.category}</span>
          <h3 id={`project-dialog-title-${project.id}`}>{project.title}</h3>
        </div>
        <button
          type="button"
          class="project-dialog-close"
          data-dialog-close
          aria-label={ui.projects.close}
        >
          <span class="i-material-symbols:close icon" style="font-size:20px;width:20px;height:20px" aria-hidden="true"></span>
        </button>
      </div>

      <div class="project-dialog-body">
        <div class="project-highlights project-dialog-highlights">
          {project.highlights.map((h) => (
            <div>
              <strong class="font-mono">{h.value}</strong>
              <span>{h.label}</span>
            </div>
          ))}
        </div>

        <div class="case-study-stack">
          <div class="case-study-block">
            <h4 class="font-mono">{ui.projects.problem}</h4>
            <p>{project.caseStudy.problem}</p>
          </div>
          <div class="case-study-block">
            <h4 class="font-mono">{ui.projects.approach}</h4>
            <p>{project.caseStudy.approach}</p>
          </div>
          <div class="case-study-block">
            <h4 class="font-mono">{ui.projects.outcome}</h4>
            <p>{project.caseStudy.outcome}</p>
          </div>
        </div>

        <div class="project-dialog-footer">
          <div class="project-tags">
            {project.tech.map((t) => <span class="font-mono">{t}</span>)}
          </div>
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--large btn--primary btn--pill"
          >
            {ui.projects.viewGithub}
            <span class="i-material-symbols:arrow-outward icon" style="font-size:18px;width:18px;height:18px" aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </dialog>
  ))}
</section>
