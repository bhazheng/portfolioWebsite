---
import { PROJECTS } from '../data/projects'
import { UI, type Locale } from '../i18n'

interface Props { lang: Locale }
const { lang } = Astro.props
const ui = UI[lang]
---
<section id="projects" class="rei-section page-width">
  <div class="section-heading" data-reveal>
    <span class="eyebrow font-mono" aria-hidden="true"><span>//</span> 03 · {ui.nav.projects}</span>
    <h2>{ui.projects.heading}<span class="heading-dot">.</span></h2>
    <p>{ui.projects.subtitle}</p>
  </div>

  <div class="project-grid">
    {PROJECTS[lang].map((project, index) => (
      <a
        href={project.link}
        target="_blank"
        rel="noopener noreferrer"
        class:list={['project-card', project.artClass]}
        data-reveal
        data-reveal-delay={index * 150}
      >
        <div class="project-art">
          <span class="project-category font-mono">{project.category}</span>
          <span class:list={[project.glyph, 'project-glyph', 'icon']} style="font-size:96px;width:96px;height:96px" aria-hidden="true"></span>
          <span class="project-number font-mono">{String(index + 1).padStart(2, '0')}</span>
          <span class="project-arrow">
            <span class="i-material-symbols:arrow-outward icon" style="font-size:20px;width:20px;height:20px" aria-hidden="true"></span>
          </span>
        </div>
        <div class="project-content">
          <svg class="card-accessory acc-0" viewBox="0 0 100 100" fill="none" aria-hidden="true">
            <path d="M50 5 L95 50 L50 95 L5 50 Z" fill="currentColor" opacity="0.18" />
            <circle cx="50" cy="50" r="15" fill="currentColor" opacity="0.22" />
            <circle cx="50" cy="50" r="4" fill="currentColor" opacity="0.35" />
          </svg>
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <div class="project-highlights">
            {project.highlights.map((h) => (
              <div>
                <strong class="font-mono">{h.value}</strong>
                <span>{h.label}</span>
              </div>
            ))}
          </div>
          <div class="project-tags">
            {project.tech.map((t) => <span class="font-mono">{t}</span>)}
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
