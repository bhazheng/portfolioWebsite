---
import { Image } from 'astro:assets'
import portrait from '../assets/profile.jpeg'
import { UI, CV_URL, type Locale } from '../i18n'

interface Props { lang: Locale }
const { lang } = Astro.props
const ui = UI[lang]
---
<section id="hero" class="hero-section page-width">
  <div class="hero-copy">
    <div class="hero-intro" data-reveal data-reveal-delay="0">
      <span class="hero-intro-line"></span>
      {ui.hero.intro}
    </div>

    <h1 class="hero-headline" data-reveal data-reveal-delay="150">
      <span class="hl">Business Analyst</span><br>
      <span class="hl">&amp; <span class="accent">Data Storyteller</span></span>
    </h1>

    <p class="hero-copy" data-reveal data-reveal-delay="300">
      {ui.hero.paragraph}
    </p>

    <p class="status-chip" data-reveal data-reveal-delay="380">
      <span class="status-dot" aria-hidden="true"></span>
      {ui.hero.status}
    </p>

    <div class="hero-actions" data-reveal data-reveal-delay="450">
      <div class="btn-group">
        <div class="split-btn">
          <a href="mailto:akbarlucky@protonmail.com" class="btn btn--large btn--primary split-btn-lead">
            {ui.hero.emailCta}
          </a>
          <button
            type="button"
            class="btn btn--large btn--primary split-btn-trail"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls="hero-contact-menu"
            aria-label={ui.hero.moreContact}
          >
            <span class="i-material-symbols:keyboard-arrow-down icon" style="font-size:20px;width:20px;height:20px" aria-hidden="true"></span>
          </button>
          <div id="hero-contact-menu" class="split-menu" role="menu" hidden>
            <button
              type="button"
              class="split-menu-item"
              role="menuitem"
              data-split-copy="akbarlucky@protonmail.com"
              data-label-copied={ui.hero.emailCopied}
            >
              <span class="i-material-symbols:content-copy icon" style="font-size:18px;width:18px;height:18px" aria-hidden="true"></span>
              <span class="split-menu-label">{ui.hero.copyEmail}</span>
            </button>
            <a
              href="https://wa.me/6285172455808"
              target="_blank"
              rel="noopener noreferrer"
              class="split-menu-item"
              role="menuitem"
            >
              <span class="i-mdi:whatsapp icon brand-whatsapp" style="font-size:18px;width:18px;height:18px" aria-hidden="true"></span>
              <span>WhatsApp</span>
            </a>
            <a
              href="https://www.linkedin.com/in/akbarlucky/"
              target="_blank"
              rel="noopener noreferrer"
              class="split-menu-item"
              role="menuitem"
            >
              <span class="i-mdi:linkedin icon brand-linkedin" style="font-size:18px;width:18px;height:18px" aria-hidden="true"></span>
              <span>LinkedIn</span>
            </a>
          </div>
        </div>
        <a
          href={CV_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--large btn--tonal btn--pill"
          aria-label={`${ui.hero.cvCta} (${ui.hero.newTab})`}
        >
          <span class="i-material-symbols:description icon" style="font-size:20px;width:20px;height:20px" aria-hidden="true"></span>
          {ui.hero.cvCta}
        </a>
      </div>
      <a href="#projects" class="text-link">
        {ui.hero.projectsCta}
        <span class="i-material-symbols:arrow-downward icon" style="font-size:18px;width:18px;height:18px" aria-hidden="true"></span>
      </a>
    </div>

    <div class="hero-socials" data-reveal data-reveal-delay="550">
      <a
        href="https://www.linkedin.com/in/akbarlucky/"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--small btn--text"
      >
        <span class="i-mdi:linkedin icon brand-linkedin" style="font-size:20px;width:20px;height:20px" aria-hidden="true"></span>
        LinkedIn
      </a>
      <a
        href="https://wa.me/6285172455808"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--small btn--text"
      >
        <span class="i-mdi:whatsapp icon brand-whatsapp" style="font-size:20px;width:20px;height:20px" aria-hidden="true"></span>
        WhatsApp
      </a>
      <a
        href="https://github.com/bhazheng"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--small btn--text"
      >
        <span class="i-mdi:github icon" style="font-size:20px;width:20px;height:20px" aria-hidden="true"></span>
        GitHub
      </a>
    </div>
  </div>

  <!-- Hero art: M3 Expressive 4-lobe Clover portrait frame + stickers -->
  <div class="hero-art" data-reveal data-reveal-delay="350">
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <clipPath id="m3e-clover" clipPathUnits="objectBoundingBox">
          <path d="M 0.8730 0.5000 L 0.8797 0.5187 L 0.8987 0.5393 L 0.9230 0.5628 L 0.9435 0.5882 L 0.9601 0.6153 L 0.9730 0.6435 L 0.9822 0.6725 L 0.9879 0.7021 L 0.9900 0.7317 L 0.9887 0.7612 L 0.9840 0.7901 L 0.9761 0.8181 L 0.9651 0.8449 L 0.9512 0.8703 L 0.9345 0.8938 L 0.9153 0.9153 L 0.8938 0.9345 L 0.8703 0.9512 L 0.8449 0.9651 L 0.8181 0.9761 L 0.7901 0.9840 L 0.7612 0.9887 L 0.7317 0.9900 L 0.7021 0.9879 L 0.6725 0.9822 L 0.6435 0.9730 L 0.6153 0.9601 L 0.5882 0.9435 L 0.5628 0.9230 L 0.5393 0.8986 L 0.5186 0.8796 L 0.5000 0.8730 L 0.4813 0.8797 L 0.4607 0.8987 L 0.4372 0.9230 L 0.4118 0.9435 L 0.3847 0.9601 L 0.3565 0.9730 L 0.3275 0.9822 L 0.2979 0.9879 L 0.2683 0.9900 L 0.2388 0.9887 L 0.2099 0.9840 L 0.1819 0.9761 L 0.1551 0.9651 L 0.1297 0.9512 L 0.1062 0.9345 L 0.0847 0.9153 L 0.0655 0.8938 L 0.0488 0.8703 L 0.0349 0.8449 L 0.0239 0.8181 L 0.0160 0.7901 L 0.0113 0.7612 L 0.0100 0.7317 L 0.0121 0.7021 L 0.0178 0.6725 L 0.0270 0.6435 L 0.0399 0.6153 L 0.0565 0.5882 L 0.0770 0.5628 L 0.1013 0.5393 L 0.1203 0.5187 L 0.1270 0.5000 L 0.1204 0.4814 L 0.1014 0.4607 L 0.0770 0.4372 L 0.0565 0.4118 L 0.0399 0.3847 L 0.0270 0.3565 L 0.0178 0.3275 L 0.0121 0.2979 L 0.0100 0.2683 L 0.0113 0.2388 L 0.0160 0.2099 L 0.0239 0.1819 L 0.0349 0.1551 L 0.0488 0.1297 L 0.0655 0.1062 L 0.0847 0.0847 L 0.1062 0.0655 L 0.1297 0.0488 L 0.1551 0.0349 L 0.1819 0.0239 L 0.2099 0.0160 L 0.2388 0.0113 L 0.2683 0.0100 L 0.2979 0.0121 L 0.3275 0.0178 L 0.3565 0.0270 L 0.3847 0.0399 L 0.4118 0.0565 L 0.4372 0.0770 L 0.4607 0.1014 L 0.4814 0.1204 L 0.5000 0.1270 L 0.5187 0.1203 L 0.5393 0.1013 L 0.5628 0.0770 L 0.5882 0.0565 L 0.6153 0.0399 L 0.6435 0.0270 L 0.6725 0.0178 L 0.7021 0.0121 L 0.7317 0.0100 L 0.7612 0.0113 L 0.7901 0.0160 L 0.8181 0.0239 L 0.8449 0.0349 L 0.8703 0.0488 L 0.8938 0.0655 L 0.9153 0.0847 L 0.9345 0.1062 L 0.9512 0.1297 L 0.9651 0.1551 L 0.9761 0.1819 L 0.9840 0.2099 L 0.9887 0.2388 L 0.9900 0.2683 L 0.9879 0.2979 L 0.9822 0.3275 L 0.9730 0.3565 L 0.9601 0.3847 L 0.9435 0.4118 L 0.9230 0.4372 L 0.8986 0.4607 L 0.8796 0.4814 Z" />
        </clipPath>
      </defs>
    </svg>
    <div class="portrait-frame">
      <Image
        src={portrait}
        alt={ui.hero.portraitAlt}
        class="hero-portrait"
        width={390}
        height={390}
        densities={[1, 2]}
        format="webp"
        quality={80}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <div class="orbit-symbol">
      <span class="i-material-symbols:monitoring icon" style="font-size:40px;width:40px;height:40px" aria-hidden="true"></span>
    </div>

    <div class="code-sticker">
      <span class="i-material-symbols:code icon" style="font-size:32px;width:32px;height:32px" aria-hidden="true"></span>
    </div>

    <div class="identity-sticker">
      <strong>ALB.</strong>
      <span>Analyst</span>
    </div>
  </div>
</section>
