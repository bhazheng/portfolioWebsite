---
import { SKILL_CATEGORIES } from '../data/skills'
import { UI, type Locale } from '../i18n'

interface Props { lang: Locale }
const { lang } = Astro.props
const ui = UI[lang]
---
<section id="skills" class="rei-section page-width">
  <div class="section-heading" data-reveal>
    <span class="eyebrow font-mono" aria-hidden="true"><span>//</span> 04 · {ui.nav.skills}</span>
    <h2>{ui.skills.heading}<span class="heading-dot">.</span></h2>
    <p>{ui.skills.subtitle}</p>
  </div>

  <div class="skills-grid">
    {SKILL_CATEGORIES[lang].map((cat, index) => (
      <div class="skill-card" data-accent={index % 3} data-reveal data-reveal-delay={index * 100}>
        <svg class:list={['card-accessory', `acc-${index % 3}`]} viewBox="0 0 100 100" fill="none" aria-hidden="true">
          <path class="accessory-morph" d="M 96.3 50.0 L 95.2 54.5 L 92.2 58.4 L 88.2 61.6 L 84.4 64.2 L 81.5 66.9 L 80.0 70.0 L 79.4 74.1 L 79.0 79.0 L 77.9 84.0 L 75.5 88.2 L 71.8 90.8 L 67.1 91.4 L 62.2 90.2 L 57.6 88.2 L 53.6 86.4 L 50.0 85.7 L 46.4 86.4 L 42.4 88.2 L 37.8 90.2 L 32.9 91.4 L 28.2 90.8 L 24.5 88.2 L 22.1 84.0 L 21.0 79.0 L 20.6 74.1 L 20.0 70.0 L 18.5 66.9 L 15.6 64.2 L 11.8 61.6 L 7.8 58.4 L 4.8 54.5 L 3.7 50.0 L 4.8 45.5 L 7.8 41.6 L 11.8 38.4 L 15.6 35.8 L 18.5 33.1 L 20.0 30.0 L 20.6 25.9 L 21.0 21.0 L 22.1 16.0 L 24.5 11.8 L 28.2 9.2 L 32.9 8.6 L 37.8 9.8 L 42.4 11.8 L 46.4 13.6 L 50.0 14.3 L 53.6 13.6 L 57.6 11.8 L 62.2 9.8 L 67.1 8.6 L 71.8 9.2 L 75.5 11.8 L 77.9 16.0 L 79.0 21.0 L 79.4 25.9 L 80.0 30.0 L 81.5 33.1 L 84.4 35.8 L 88.2 38.4 L 92.2 41.6 L 95.2 45.5 Z" fill="currentColor" opacity="0.18" />
          <circle cx="50" cy="50" r="14" fill="currentColor" opacity="0.22" />
        </svg>
        <div class="skill-card-head">
          <div class="skill-card-icon" style={`--tile:var(--v-theme-${cat.color})`}>
            <span class:list={[cat.icon, 'icon', `text-${cat.color}`]} style="font-size:24px;width:24px;height:24px" aria-hidden="true"></span>
          </div>
          <h3>{cat.title}</h3>
        </div>
        <ul class="skill-list">
          {cat.skills.map((skill) => (
            <li>
              <span class="skill-name">{skill.name}</span>
              {skill.appliedIn && <span class="skill-applied font-mono">{skill.appliedIn}</span>}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
