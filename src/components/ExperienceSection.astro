---
import { EXPERIENCE } from '../data/experience'
import { UI, type Locale } from '../i18n'

interface Props { lang: Locale }
const { lang } = Astro.props
const ui = UI[lang]
---
<section id="experience" class="rei-section page-width">
  <div class="experience-grid">
    <!-- Left: intro + stamp -->
    <div class="experience-intro">
      <div class="section-heading" data-reveal>
        <span class="eyebrow font-mono" aria-hidden="true"><span>//</span> 01 · {ui.nav.experience}</span>
        <h2>{ui.experience.heading}<span class="heading-dot">.</span></h2>
        <p>{ui.experience.subtitle}</p>
      </div>
      <div data-reveal data-reveal-delay="200">
        <div class="experience-stamp">
          <span class="i-material-symbols:workspace-premium icon" style="font-size:28px;width:28px;height:28px" aria-hidden="true"></span>
          <span>{ui.experience.stamp}</span>
        </div>
      </div>
    </div>

    <!-- Right: timeline list -->
    <div class="experience-timeline">
      {EXPERIENCE[lang].map((entry, i) => (
        <div class:list={['exp-entry', { current: entry.current }]} data-reveal>
          <!-- Timeline rail + company avatar -->
          <div class="exp-rail">
            <div class:list={['exp-avatar', { ongoing: entry.current }]}>
              {entry.organization.charAt(0)}
            </div>
          </div>

          <!-- Card body (M3 filled card — tonal elevation, no outline) -->
          <div class="exp-card">
            <!-- Vector accessory: decorative corner shape -->
            <svg
              class:list={['card-accessory', `acc-${i % 3}`]}
              viewBox="0 0 120 120"
              fill="none"
              aria-hidden="true"
            >
              <circle cx="60" cy="60" r="48" fill="currentColor" opacity="0.16" />
              <circle cx="60" cy="60" r="28" fill="currentColor" opacity="0.2" />
              <circle cx="60" cy="60" r="6" fill="currentColor" opacity="0.35" />
            </svg>

            <div class="exp-card-head">
              <div class="exp-head-text">
                <h3>{entry.organization}</h3>
                <div class="exp-period font-mono">
                  {entry.period} · {entry.location}
                </div>
              </div>
              <span class="employment-type font-mono">{entry.type}</span>
            </div>

            <div class="exp-role-row">
              <h4>{entry.role}</h4>
              {entry.current && <span class="current-badge font-mono">{ui.experience.current}</span>}
            </div>
            {entry.team && <p class="exp-team">{entry.team}</p>}

            <ul class="experience-bullets">
              <li>{entry.bullets[0]}</li>
            </ul>
            {entry.bullets.length > 1 && (
              <details class="exp-more" open={entry.current}>
                <summary class="font-mono">
                  <span class="exp-more-closed">{ui.experience.more.replace('{n}', String(entry.bullets.length - 1))}</span>
                  <span class="exp-more-open">{ui.experience.less}</span>
                </summary>
                <ul class="experience-bullets">
                  {entry.bullets.slice(1).map((bullet) => <li>{bullet}</li>)}
                </ul>
              </details>
            )}

            <div class="experience-metrics">
              {entry.metrics.map((metric) => (
                <div class="metric-tile">
                  <div class="metric-value font-mono">{metric.value}</div>
                  <div class="metric-label">{metric.label}</div>
                </div>
              ))}
            </div>

            <div class="exp-tech-chips">
              {entry.tech.map((tech) => <span class="font-mono">{tech}</span>)}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
