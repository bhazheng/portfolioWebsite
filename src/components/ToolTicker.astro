---
import { TOOLS } from '../data/tools'

// The track scrolls -50%, so each half must be wider than the viewport. With 12 tools, one copy
// is ~1,950 px wide: 2 copies per half (4 total, ~3,900 px/half) keeps the loop seamless.
const COPIES = 4
---
<!-- Decorative: repeats tools already listed in Skills, so it is hidden from assistive tech. -->
<div class="tool-ticker" aria-hidden="true">
  <div class="tool-ticker-track">
    {Array.from({ length: COPIES }, () => (
      <ul>
        {TOOLS.map((tool) => (
          <li>
            <span class="tool-chip" style={`--logo-color:${tool.color}`}>
              <span class={`${tool.icon} tool-logo`}></span>
              <span class="tool-name">{tool.name}</span>
            </span>
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>
